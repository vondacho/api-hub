---
import { contractLabel, type Specification } from '../../lib/registry';

interface Props {
	specification: Specification;
}

const { specification: spec } = Astro.props;

/* A component link is optional in the contract — show the row only when there is one. */
const component = spec.componentName
	? [spec.componentName, spec.componentRevision].filter(Boolean).join(' · ')
	: undefined;
---

<li class="h-full">
	<a
		href={`/catalog/${spec.documentId}`}
		class="group flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-brand hover:shadow-md motion-reduce:hover:translate-y-0 dark:border-slate-700 dark:bg-night-raised dark:hover:border-sky-400"
	>
		<span class="flex items-start justify-between gap-3">
			<h3 class="text-lg font-semibold break-words">{spec.name}</h3>
			<span class="shrink-0 rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold tracking-wide text-ink-muted uppercase dark:bg-slate-700 dark:text-slate-300">
				{contractLabel(spec.contract)}
			</span>
		</span>

		<dl class="mt-4 grow space-y-1.5 text-sm">
			<div class="flex gap-2">
				<dt class="w-28 shrink-0 text-ink-muted dark:text-slate-400">Revision</dt>
				<dd class="font-mono">{spec.revision}</dd>
			</div>
			<div class="flex gap-2">
				<dt class="w-28 shrink-0 text-ink-muted dark:text-slate-400">Product</dt>
				<dd>{spec.productName}</dd>
			</div>
			<div class="flex gap-2">
				<dt class="w-28 shrink-0 text-ink-muted dark:text-slate-400">Bundle</dt>
				<dd>{spec.bundleName}</dd>
			</div>
			{
				component && (
					<div class="flex gap-2">
						<dt class="w-28 shrink-0 text-ink-muted dark:text-slate-400">Component</dt>
						<dd>{component}</dd>
					</div>
				)
			}
		</dl>

		<span class="mt-5 text-sm font-semibold text-brand dark:text-sky-400">
			View contract
			<span aria-hidden="true" class="inline-block transition group-hover:translate-x-1 motion-reduce:transition-none">
				&nbsp;→
			</span>
		</span>
	</a>
</li>
