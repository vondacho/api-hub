---
import heroBackground from '../../assets/hero-background.svg';

/*
 * The platform's ten features, in the order the root README enumerates them.
 * Split by what is actually deployable today: onboarding, registry, catalog,
 * scoring and documentation have modules behind them; the other five are the
 * target topology the README describes and have no service yet.
 *
 * The split is the point — the banner is allowed to describe the whole
 * lifecycle, but it must not let a visitor believe they can mock a contract or
 * wrap it for an agent today. Move a feature up when its module ships, and keep
 * the wording in step with the panels in SectionPanels.astro.
 */
const available = ['Onboarding', 'Registry', 'Catalog', 'Scoring', 'Documentation'] as const;
const planned = ['Monitoring', 'Discovery', 'Mocking', 'MCP wrapping', 'MCP registry'] as const;
---

<section class="relative isolate flex min-h-[min(70vh,620px)] items-center overflow-hidden px-6 py-20 text-slate-100 sm:py-28">
	<!--
		The backdrop is decorative: it carries nothing the copy does not, so it is
		empty-alt and aria-hidden. The copy sits on a gradient scrim rather than on
		the artwork itself, so contrast never depends on where the image is dark.
	-->
	<!--
		Deliberately a plain <img>, not <Image>: the backdrop is vector, so there is
		nothing to resize or re-encode, and routing it through astro:assets would
		put a request on the SSR image endpoint on every page view for no gain.
		The import still gets the asset hashed and fingerprinted.
	-->
	<img
		class="absolute inset-0 -z-20 h-full w-full object-cover"
		src={heroBackground.src}
		width={heroBackground.width}
		height={heroBackground.height}
		alt=""
		aria-hidden="true"
		loading="eager"
		decoding="async"
	/>
	<div
		class="absolute inset-0 -z-10 bg-linear-100 from-slate-950/95 via-slate-950/75 to-slate-950/35"
	>
	</div>

	<div class="mx-auto w-full max-w-5xl">
		<p class="text-xs font-semibold tracking-[0.16em] text-sky-300 uppercase">
			API contract lifecycle platform
		</p>
		<h1 class="mt-3 max-w-3xl text-4xl font-bold tracking-tight text-balance sm:text-5xl lg:text-6xl">
			Every API, under contract.
		</h1>
		<p class="mt-5 max-w-2xl text-base text-slate-300 sm:text-lg">
			API Hub runs the whole life of an API contract — from the commit that changes a
			specification to the agent that calls the API it describes. Contracts in OpenAPI,
			AsyncAPI, GraphQL and WSDL are discovered, parsed, validated, scored against your
			design guidelines and registered revision by revision — then made useful:
			searchable in a catalog, documented, mocked on demand, monitored across
			deployments, and wrapped as tools an agent can call.
		</p>
		<div class="mt-8 flex flex-wrap gap-3">
			<a
				href="/doc/"
				class="rounded-full bg-brand px-6 py-3 font-semibold text-white transition hover:bg-brand-strong focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-sky-300"
			>
				Read the documentation
			</a>
			<a
				href="/doc/onboarding/"
				class="rounded-full border border-white/35 px-6 py-3 font-semibold text-slate-100 transition hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-sky-300"
			>
				Onboard a contract
			</a>
		</div>

		<!--
			Two lists rather than one styled two ways: "planned" has to survive being
			read out by a screen reader or seen without colour, so the grouping carries
			the meaning and the dimmer pills only reinforce it.
		-->
		<div class="mt-10 flex flex-col gap-3 border-t border-white/15 pt-6">
			<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
				<span id="hero-available" class="text-xs font-semibold tracking-[0.14em] text-sky-300 uppercase">
					Available
				</span>
				<ul aria-labelledby="hero-available" class="flex flex-wrap gap-2">
					{
						available.map((feature) => (
							<li class="rounded-full bg-white/12 px-3 py-1 text-sm font-medium text-slate-100">
								{feature}
							</li>
						))
					}
				</ul>
			</div>

			<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
				<span id="hero-planned" class="text-xs font-semibold tracking-[0.14em] text-slate-300 uppercase">
					Planned
				</span>
				<ul aria-labelledby="hero-planned" class="flex flex-wrap gap-2">
					{
						planned.map((feature) => (
							<li class="rounded-full border border-white/25 px-3 py-1 text-sm font-medium text-slate-300">
								{feature}
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</div>
</section>
