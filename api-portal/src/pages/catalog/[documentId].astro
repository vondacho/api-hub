---
import Layout from '../../layouts/Layout.astro';
import SiteFooter from '../../components/home/SiteFooter.astro';
import ContractViewer from '../../components/catalog/ContractViewer.astro';
import { contractLabel, specificationAt } from '../../lib/registry';

const { documentId } = Astro.params;

const specification = documentId ? await specificationAt(documentId) : undefined;

if (!specification) {
	// An unknown id is a 404, not an empty page — the status code matters to
	// anything crawling or monitoring the catalogue.
	return new Response('Specification not found', { status: 404 });
}

const facts = [
	{ label: 'Revision', value: specification.revision, mono: true },
	{ label: 'Version', value: specification.version, mono: true },
	{ label: 'Product', value: specification.productName },
	{ label: 'Bundle', value: specification.bundleName },
	{ label: 'Contract', value: contractLabel(specification.contract) },
	...(specification.componentName
		? [
				{
					label: 'Component',
					value: [specification.componentName, specification.componentRevision]
						.filter(Boolean)
						.join(' · '),
				},
			]
		: []),
];
---

<Layout
	title={`${specification.name} — Catalog — API Hub`}
	description={`The registered ${contractLabel(specification.contract)} contract for ${specification.name}, revision ${specification.revision}.`}
>
	<main id="main">
		<header class="border-b border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-night-raised">
			<div class="mx-auto w-full max-w-5xl px-6 py-10">
				<nav class="text-sm text-ink-muted dark:text-slate-400">
					<a href="/" class="hover:text-brand hover:underline dark:hover:text-sky-400">Home</a>
					<span aria-hidden="true"> / </span>
					<a href="/catalog" class="hover:text-brand hover:underline dark:hover:text-sky-400">Catalog</a>
					<span aria-hidden="true"> / </span>
					<span>{specification.name}</span>
				</nav>

				<h1 class="mt-4 text-3xl font-bold tracking-tight break-words sm:text-4xl">
					{specification.name}
				</h1>

				<dl class="mt-6 grid gap-x-8 gap-y-3 sm:grid-cols-2 lg:grid-cols-3">
					{
						facts.map(({ label, value, mono }) => (
							<div>
								<dt class="text-xs font-semibold tracking-[0.12em] text-ink-muted uppercase dark:text-slate-400">
									{label}
								</dt>
								<dd class={mono ? 'font-mono' : undefined}>{value}</dd>
							</div>
						))
					}
				</dl>
			</div>
		</header>

		<div class="mx-auto w-full max-w-5xl px-6 py-10">
			<ContractViewer specification={specification} />
		</div>
	</main>
	<SiteFooter />
</Layout>
