{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    // Layer aliases, so a cross-layer import names the layer instead of
    // counting "../" hops. These mirror the "imports" map in package.json —
    // tsc resolves specifiers through these, Node resolves the emitted JS
    // through that map, and the two must stay in step.
    "paths": {
      "#domain/*": ["./src/domain/*"],
      "#appl/*": ["./src/appl/*"],
      "#adapter/*": ["./src/adapter/*"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": false
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
